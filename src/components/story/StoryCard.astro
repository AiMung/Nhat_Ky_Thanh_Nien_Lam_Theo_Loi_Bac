---
import { withBase, formatDate } from '@/lib/utils';
import type { Story } from '@/lib/storage';

interface Props {
  story: Story;
  featured?: boolean;
}

const { story, featured = false } = Astro.props;
---

<article class={`bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col group ${featured ? 'lg:grid lg:grid-cols-12 lg:gap-6 border-slate-300' : ''}`}>
  
  <!-- Hình ảnh câu chuyện sắc nét kèm nhãn danh mục chuẩn Enterprise -->
  <div class={`relative overflow-hidden ${featured ? 'lg:col-span-7 h-72 lg:h-full' : 'h-52'} bg-slate-100`}>
    <img 
      src={story.cover_url} 
      alt={story.title} 
      loading="lazy" 
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
    />
    
    <!-- Lớp phủ bóng mờ nhẹ nhàng ở đáy ảnh -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>

    <!-- Huy hiệu Địa phương & Năm sự kiện (Frosted Glass tinh tế) -->
    <div class="absolute top-3 left-3 flex items-center gap-1.5 flex-wrap">
      <span class="bg-slate-950/70 backdrop-blur-md text-white text-[11px] font-medium px-2.5 py-0.5 rounded-full shadow-sm">
        📍 {story.province_name}
      </span>
      {story.event_year && (
        <span class="bg-slate-950/70 backdrop-blur-md text-white text-[11px] font-medium px-2 py-0.5 rounded-full shadow-sm">
          {story.event_year}
        </span>
      )}
      {story.images && story.images.length > 1 && (
        <span class="bg-slate-950/70 backdrop-blur-md text-amber-300 text-[11px] font-semibold px-2 py-0.5 rounded-full shadow-sm flex items-center gap-1">
          📷 {story.images.length}
        </span>
      )}
    </div>

    <!-- Tên chủ đề & thời gian đọc nổi bật trên ảnh -->
    <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-xs text-white">
      <span class="font-bold text-[11px] text-red-800 bg-white/95 backdrop-blur px-2.5 py-0.5 rounded-md shadow-xs uppercase tracking-wider">
        {story.category_name}
      </span>
      <span class="text-[11px] text-white/90 font-medium drop-shadow">
        ⏱️ {story.read_minutes} phút đọc
      </span>
    </div>
  </div>

  <!-- Phần Nội dung & Metadata nhất quán chuẩn Enterprise -->
  <div class={`p-5 flex-1 flex flex-col justify-between ${featured ? 'lg:col-span-5 lg:py-6 lg:pr-6 lg:pl-0' : ''}`}>
    <div>
      <div class="flex items-center gap-2 text-xs text-slate-400 mb-2 font-medium">
        <span>{formatDate(story.published_at || story.created_at)}</span>
        <span>•</span>
        <span class="text-slate-500">{story.period === '1989-nay' ? 'Thời kỳ đổi mới' : 'Thời kỳ lịch sử'}</span>
      </div>

      <h3 class={`font-serif font-bold text-slate-900 leading-snug group-hover:text-red-700 transition-colors mb-2 line-clamp-2 ${featured ? 'text-xl lg:text-2xl' : 'text-base sm:text-lg'}`}>
        <a href={withBase(`/truyen/${story.slug}`)}>
          {story.title}
        </a>
      </h3>

      <p class="text-xs sm:text-sm text-slate-600 line-clamp-3 leading-relaxed mb-4">
        {story.summary}
      </p>
    </div>

    <!-- Thông tin Người kể và Đơn vị ghi chép riêng biệt -->
    <div class="pt-3.5 border-t border-slate-100 flex items-center justify-between gap-3 text-xs">
      <div class="truncate">
        <div class="text-slate-800 font-semibold truncate">
          Kể: <span class="text-slate-900">{story.narrator_name}</span>
        </div>
        <div class="text-slate-400 text-[11px] truncate mt-0.5" title={story.contributor_unit || story.contributor_name}>
          {story.contributor_unit || story.contributor_name}
        </div>
      </div>

      <a 
        href={withBase(`/truyen/${story.slug}`)} 
        class="shrink-0 font-semibold text-red-700 hover:text-red-800 flex items-center gap-1 group/link bg-red-50 hover:bg-red-100 px-3 py-1.5 rounded-lg transition-colors"
      >
        <span>Đọc tiếp</span>
        <span class="group-hover/link:translate-x-0.5 transition-transform">→</span>
      </a>
    </div>

  </div>
</article>
