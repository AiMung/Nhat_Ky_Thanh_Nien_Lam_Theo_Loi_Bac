---
import { withBase } from '@/lib/utils';
import UserAuthNav from '@/components/common/UserAuthNav';
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-18 sm:h-20 gap-4">
      
      <!-- Logo Huy hiệu Đoàn & Tiêu đề đề án chuẩn Enterprise -->
      <a href={withBase('/')} class="flex items-center gap-3 shrink-0 group">
        <div class="relative w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-gradient-to-br from-red-600 to-red-800 p-0.5 shadow-sm group-hover:scale-105 transition-transform">
          <div class="w-full h-full rounded-[10px] bg-white flex items-center justify-center p-1">
            <div class="w-full h-full rounded-lg bg-gradient-to-tr from-red-700 to-blue-800 flex flex-col items-center justify-center text-white">
              <span class="text-amber-400 font-serif font-black text-base sm:text-lg leading-none">★</span>
              <span class="text-[7px] font-black tracking-widest text-amber-200 uppercase leading-none mt-0.5">ĐOÀN</span>
            </div>
          </div>
        </div>

        <div class="shrink-0">
          <div class="text-[10px] font-bold text-red-700 uppercase tracking-wider leading-none">
            THÀNH ĐOÀN TP. HỒ CHÍ MINH
          </div>
          <div class="font-bold text-slate-900 text-sm sm:text-base tracking-tight mt-1 group-hover:text-red-700 transition-colors whitespace-nowrap">
            NHẬT KÝ THANH NIÊN LÀM THEO LỜI BÁC
          </div>
        </div>
      </a>

      <!-- Menu Điều hướng chính trên Desktop (Chuẩn Enterprise: Rõ ràng, không bị co chữ) -->
      <nav class="hidden xl:flex items-center gap-1 text-sm font-medium text-slate-600">
        <a href={withBase('/')} class="px-3.5 py-2 rounded-lg hover:text-red-700 hover:bg-slate-50 transition-colors whitespace-nowrap">
          Trang chủ
        </a>
        <a href={withBase('/thu-vien')} class="px-3.5 py-2 rounded-lg hover:text-red-700 hover:bg-slate-50 transition-colors whitespace-nowrap">
          Thư viện
        </a>
        <a href={withBase('/ban-do')} class="px-3.5 py-2 rounded-lg hover:text-red-700 hover:bg-slate-50 transition-colors whitespace-nowrap">
          Bản đồ Địa chỉ Đỏ
        </a>
        <a href={withBase('/dong-thoi-gian')} class="px-3.5 py-2 rounded-lg hover:text-red-700 hover:bg-slate-50 transition-colors whitespace-nowrap">
          Dòng thời gian
        </a>
        <a href={withBase('/tai-khoan/truyen-cua-toi')} class="px-3.5 py-2 rounded-lg hover:text-red-700 hover:bg-slate-50 transition-colors whitespace-nowrap">
          Truyện của tôi
        </a>
      </nav>

      <!-- Khung tài khoản & Nút gửi bài + Mobile Hamburger -->
      <div class="flex items-center gap-2 shrink-0">
        <UserAuthNav client:load />

        <!-- Nút mở menu trên Mobile / Tablet -->
        <button
          id="btnToggleMobileMenu"
          type="button"
          aria-label="Mở menu"
          class="xl:hidden p-2 rounded-xl text-slate-700 hover:bg-slate-100 border border-slate-200 transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobileMenuDrawer" class="hidden xl:hidden border-t border-slate-200 bg-white px-4 py-3 space-y-1 shadow-lg">
    <a href={withBase('/')} class="block px-3 py-2 rounded-lg font-semibold text-slate-800 hover:bg-slate-50 hover:text-red-700">
      Trang chủ
    </a>
    <a href={withBase('/thu-vien')} class="block px-3 py-2 rounded-lg font-semibold text-slate-800 hover:bg-slate-50 hover:text-red-700">
      Thư viện nhật ký
    </a>
    <a href={withBase('/ban-do')} class="block px-3 py-2 rounded-lg font-semibold text-slate-800 hover:bg-slate-50 hover:text-red-700">
      Bản đồ Địa chỉ Đỏ
    </a>
    <a href={withBase('/dong-thoi-gian')} class="block px-3 py-2 rounded-lg font-semibold text-slate-800 hover:bg-slate-50 hover:text-red-700">
      Dòng thời gian
    </a>
    <a href={withBase('/tai-khoan/truyen-cua-toi')} class="block px-3 py-2 rounded-lg font-semibold text-slate-800 hover:bg-slate-50 hover:text-red-700">
      Truyện của tôi
    </a>
    <a href={withBase('/quan-tri/duyet-bai')} class="block px-3 py-2 rounded-lg font-semibold text-red-700 bg-red-50">
      Hàng đợi Kiểm duyệt
    </a>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('btnToggleMobileMenu');
  const drawer = document.getElementById('mobileMenuDrawer');
  if (btn && drawer) {
    btn.addEventListener('click', () => {
      drawer.classList.toggle('hidden');
    });
  }
</script>
