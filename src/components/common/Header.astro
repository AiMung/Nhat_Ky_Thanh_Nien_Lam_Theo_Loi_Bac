---
import { withBase } from '@/lib/utils';
import UserAuthNav from '@/components/common/UserAuthNav';
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-18 sm:h-20 gap-4">
      
      <!-- Logo Huy hiệu Đoàn & Tiêu đề đề án chuẩn Enterprise -->
      <a href={withBase('/')} class="flex items-center gap-3 shrink-0 group">
        <img
          src={withBase('/images/thoi-hoa-lua/logo-doan.webp')}
          alt="Huy hiệu Đoàn TNCS Hồ Chí Minh"
          class="w-10 h-10 sm:w-11 sm:h-11 object-contain drop-shadow-sm group-hover:scale-105 transition-transform"
        />

        <div class="shrink-0">
          <div class="text-[10px] font-bold text-red-700 uppercase tracking-wider leading-none">
            ĐOÀN PHƯỜNG XUÂN HƯƠNG — ĐÀ LẠT
          </div>
          <div class="font-bold text-slate-900 text-sm sm:text-base tracking-tight mt-1 group-hover:text-red-700 transition-colors whitespace-nowrap">
            NHẬT KÝ THANH NIÊN LÀM THEO LỜI BÁC
          </div>
        </div>
      </a>

      <!-- Menu Điều hướng chính cho Độc giả -->
      <nav class="hidden xl:flex items-center gap-1 text-sm font-medium text-slate-600">
        <a href={withBase('/')} class="px-3.5 py-2 rounded-lg hover:text-red-700 hover:bg-slate-50 transition-colors whitespace-nowrap">
          Trang chủ
        </a>
        <a href={withBase('/thu-vien')} class="px-3.5 py-2 rounded-lg hover:text-red-700 hover:bg-slate-50 transition-colors whitespace-nowrap">
          Thư viện bài đọc
        </a>
        <a href={withBase('/dia-chi-do')} class="px-3.5 py-2 rounded-lg hover:text-red-700 hover:bg-slate-50 transition-colors whitespace-nowrap">
          Địa chỉ Đỏ Đà Lạt
        </a>
        <a href={withBase('/dong-thoi-gian')} class="px-3.5 py-2 rounded-lg hover:text-red-700 hover:bg-slate-50 transition-colors whitespace-nowrap">
          Dòng thời gian
        </a>
        <a href={withBase('/ve-de-an')} class="px-3.5 py-2 rounded-lg hover:text-red-700 hover:bg-slate-50 transition-colors whitespace-nowrap">
          Về đề án
        </a>
      </nav>

      <!-- Khung tài khoản & Nút gửi bài + Mobile Hamburger -->
      <div class="flex items-center gap-2 shrink-0">
        <UserAuthNav client:load />

        <!-- Nút mở menu trên Mobile / Tablet -->
        <button
          id="btnToggleMobileMenu"
          type="button"
          aria-label="Mở menu"
          class="xl:hidden p-2 rounded-xl text-slate-700 hover:bg-slate-100 border border-slate-200 transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobileMenuDrawer" class="hidden xl:hidden border-t border-slate-200 bg-white px-4 py-3 space-y-1 shadow-lg">
    <a href={withBase('/')} class="block px-3 py-2 rounded-lg font-semibold text-slate-800 hover:bg-slate-50 hover:text-red-700">
      Trang chủ
    </a>
    <a href={withBase('/thu-vien')} class="block px-3 py-2 rounded-lg font-semibold text-slate-800 hover:bg-slate-50 hover:text-red-700">
      Thư viện bài đọc
    </a>
    <a href={withBase('/dia-chi-do')} class="block px-3 py-2 rounded-lg font-semibold text-slate-800 hover:bg-slate-50 hover:text-red-700">
      Địa chỉ Đỏ Đà Lạt
    </a>
    <a href={withBase('/dong-thoi-gian')} class="block px-3 py-2 rounded-lg font-semibold text-slate-800 hover:bg-slate-50 hover:text-red-700">
      Dòng thời gian
    </a>
    <a href={withBase('/ve-de-an')} class="block px-3 py-2 rounded-lg font-semibold text-slate-800 hover:bg-slate-50 hover:text-red-700">
      Về đề án
    </a>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('btnToggleMobileMenu');
  const drawer = document.getElementById('mobileMenuDrawer');
  if (btn && drawer) {
    btn.addEventListener('click', () => {
      drawer.classList.toggle('hidden');
    });
  }
</script>
