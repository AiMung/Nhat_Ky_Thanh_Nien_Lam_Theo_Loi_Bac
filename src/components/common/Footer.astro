---
import { withBase } from '@/lib/utils';
---

<footer class="bg-slate-950 text-slate-300 mt-24 border-t-4 border-redflag-700">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      
      <!-- Cột 1: Thông tin đề án & Thành Đoàn -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-redflag-700 to-doan-800 flex items-center justify-center text-gold-300 font-serif font-black text-xl shadow">
            ★
          </div>
          <div>
            <div class="text-[11px] font-bold text-amber-400 uppercase tracking-wider">
              Đoàn TNCS Hồ Chí Minh Phường Xuân Hương — TP. Đà Lạt
            </div>
            <div class="font-serif font-black text-white text-base sm:text-lg">
              NHẬT KÝ THANH NIÊN LÀM THEO LỜI BÁC
            </div>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-slate-400 leading-relaxed max-w-lg">
          Nền tảng số hóa những câu chuyện, hồi ức chân thực và gương người tốt việc tốt của cán bộ Đoàn, cựu chiến binh và thế hệ trẻ 37 Tổ Dân Phố Phường Xuân Hương, TP. Đà Lạt cùng tuổi trẻ cả nước qua các thời kỳ.
        </p>

        <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 text-xs text-amber-300/90 leading-relaxed">
          ★ Phong trào thi đua số hóa lịch sử & học tập lời Bác của 37 Tổ Dân Phố Phường Xuân Hương — Thành phố Đà Lạt.
        </div>
      </div>

      <!-- Cột 2: Danh mục chuyên đề -->
      <div>
        <h3 class="font-serif font-bold text-white text-sm uppercase tracking-wider mb-4 border-l-2 border-gold-400 pl-2.5">
          Chuyên đề nhật ký
        </h3>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li><a href={withBase('/thu-vien')} class="hover:text-gold-300 transition-colors">Ký ức Thành Đoàn & Kháng chiến</a></li>
          <li><a href={withBase('/thu-vien')} class="hover:text-gold-300 transition-colors">Lực lượng Thanh niên Xung phong</a></li>
          <li><a href={withBase('/thu-vien')} class="hover:text-gold-300 transition-colors">30 năm Phong trào Tình nguyện</a></li>
          <li><a href={withBase('/thu-vien')} class="hover:text-gold-300 transition-colors">Tuổi trẻ vì Biển đảo quê hương</a></li>
          <li><a href={withBase('/thu-vien')} class="hover:text-gold-300 transition-colors">Gương sáng làm theo lời Bác</a></li>
        </ul>
      </div>

      <!-- Cột 3: Quản trị & Điều khoản -->
      <div>
        <h3 class="font-serif font-bold text-white text-sm uppercase tracking-wider mb-4 border-l-2 border-redflag-600 pl-2.5">
          Quy chế & Kiểm duyệt
        </h3>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li><a href={withBase('/gui-cau-chuyen')} class="hover:text-gold-300 transition-colors">Đóng góp bài viết mới</a></li>
          <li><a href={withBase('/quan-tri/duyet-bai')} class="hover:text-gold-300 transition-colors text-redflag-400 font-bold">Hàng đợi kiểm duyệt (Admin)</a></li>
          <li><a href={withBase('/ban-do')} class="hover:text-gold-300 transition-colors">Bản đồ Địa chỉ Đỏ</a></li>
          <li><a href={withBase('/dong-thoi-gian')} class="hover:text-gold-300 transition-colors">Mốc son lịch sử của Đoàn</a></li>
        </ul>
      </div>

    </div>

    <div class="border-t border-slate-800 mt-12 pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <div>
        © 2026 Thành Đoàn TP. Hồ Chí Minh - Ban Tuyên giáo & Ban Mặt trận ANQP - ĐBDC.
      </div>
      <div class="flex items-center gap-4 text-slate-400">
        <span>Vận hành phi lợi nhuận</span>
        <span>•</span>
        <span>PWA Jamstack Offline Shell</span>
      </div>
    </div>
  </div>
</footer>
