---
import { withBase } from '@/lib/utils';
---

<footer 
  class="relative text-slate-300 mt-24 border-t-4 border-amber-600 bg-slate-950 overflow-hidden"
  style={`background-image: linear-gradient(to bottom, rgba(15, 23, 42, 0.92), rgba(15, 23, 42, 0.97)), url('${withBase('/images/vintage-footer-bg.jpg')}'); background-size: cover; background-position: center bottom;`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      
      <!-- Cột 1: Thông tin đề án & Đoàn Phường Xuân Hương -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <img
            src={withBase('/images/thoi-hoa-lua/logo-doan.webp')}
            alt="Huy hiệu Đoàn TNCS Hồ Chí Minh"
            class="w-12 h-12 object-contain drop-shadow-md"
          />
          <div>
            <div class="text-[11px] font-bold text-amber-400 uppercase tracking-wider">
              Đoàn TNCS Hồ Chí Minh Phường Xuân Hương — Đà Lạt
            </div>
            <div class="font-serif font-black text-white text-base sm:text-lg">
              NHẬT KÝ THANH NIÊN LÀM THEO LỜI BÁC
            </div>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed max-w-lg">
          Nền tảng số hóa những câu chuyện, hồi ức chân thực và gương người tốt việc tốt của cán bộ Đoàn, cựu chiến binh và thế hệ trẻ 37 Tổ Dân Phố Phường Xuân Hương — Đà Lạt cùng tuổi trẻ cả nước qua các thời kỳ.
        </p>

        <div class="p-4 rounded-2xl bg-black/40 backdrop-blur-md border border-amber-400/30 text-xs text-amber-200 leading-relaxed shadow-lg">
          <span class="text-amber-400 font-bold">★ Phong trào thi đua:</span> Số hóa lịch sử, học tập và làm theo tư tưởng, đạo đức, phong cách Hồ Chí Minh của 37 Tổ Dân Phố Phường Xuân Hương — Đà Lạt.
        </div>
      </div>

      <!-- Cột 2: Danh mục chuyên đề -->
      <div>
        <h3 class="font-serif font-bold text-white text-sm uppercase tracking-wider mb-4 border-l-2 border-amber-400 pl-2.5">
          Chuyên đề nhật ký
        </h3>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li><a href={withBase('/thu-vien?cat=hoc-tap-bac')} class="hover:text-amber-300 transition-colors">Học tập & Làm theo lời Bác</a></li>
          <li><a href={withBase('/dia-chi-do')} class="hover:text-amber-300 transition-colors">Địa chỉ Đỏ & Di tích Đà Lạt</a></li>
          <li><a href={withBase('/thu-vien?cat=phong-trao-doan')} class="hover:text-amber-300 transition-colors">Tuổi trẻ Phường Xuân Hương</a></li>
          <li><a href={withBase('/thu-vien?cat=thanh-nien-xung-phong')} class="hover:text-amber-300 transition-colors">Thanh niên Xung phong kiên cường</a></li>
          <li><a href={withBase('/thu-vien?cat=bien-dao')} class="hover:text-amber-300 transition-colors">Tuổi trẻ vì Biển đảo quê hương</a></li>
        </ul>
      </div>

      <!-- Cột 3: Quản trị & Điều khoản -->
      <div>
        <h3 class="font-serif font-bold text-white text-sm uppercase tracking-wider mb-4 border-l-2 border-red-500 pl-2.5">
          Đề án & Tư liệu
        </h3>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li><a href={withBase('/ve-de-an')} class="hover:text-amber-300 transition-colors">Về Đề án Thời hoa lửa</a></li>
          <li><a href={withBase('/dia-chi-do')} class="hover:text-amber-300 transition-colors">Địa chỉ Đỏ & Di tích Đà Lạt</a></li>
          <li><a href={withBase('/dong-thoi-gian')} class="hover:text-amber-300 transition-colors">Mốc son lịch sử của Đoàn</a></li>
          <li><a href={withBase('/thu-vien')} class="hover:text-amber-300 transition-colors">Thư viện bài đọc (20 câu chuyện)</a></li>
        </ul>
      </div>

    </div>

    <div class="border-t border-slate-800/80 mt-12 pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4">
      <div>
        © 2026 Đoàn TNCS Hồ Chí Minh Phường Xuân Hương — Đà Lạt. Tự hào tuổi trẻ làm theo lời Bác.
      </div>
      <div class="flex items-center gap-4 text-slate-400">
        <span>Vận hành phục vụ nhân dân</span>
        <span>•</span>
        <span>Chủ quyền Hoàng Sa & Trường Sa</span>
      </div>
    </div>
  </div>
</footer>
