---
import RootLayout from '@/layouts/RootLayout.astro';
import StorySubmitForm from '@/components/story/StorySubmitForm';
import { withBase } from '@/lib/utils';
---

<RootLayout title="Gửi Nhật Ký Ký Ức - Đề án Thành Đoàn TP. Hồ Chí Minh">
  
  <!-- Banner tiêu đề trang Gửi câu chuyện Thời Hoa Lửa -->
  <section class="relative bg-gradient-hero text-white py-12 px-4 border-b-4 border-gold-500 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/images/thoi-hoa-lua/hero-bg.jpg"
        alt="Viết nhật ký lịch sử"
        class="w-full h-full object-cover opacity-25 filter contrast-125"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-doan-950/95 via-redflag-950/85 to-doan-950/90"></div>
    </div>

    <div class="max-w-5xl mx-auto relative z-10 text-center">
      <div class="inline-flex items-center gap-2 text-xs text-gold-300 font-bold mb-3 uppercase tracking-wider bg-slate-950/70 px-3.5 py-1 rounded-full border border-gold-500/40">
        <a href={withBase('/')} class="hover:underline">Trang chủ</a>
        <span>/</span>
        <span class="text-white">Đóng góp câu chuyện</span>
      </div>

      <h1 class="font-serif font-black text-2xl sm:text-4xl text-white tracking-tight leading-tight mb-2">
        VIẾT & ĐÓNG GÓP TRANG NHẬT KÝ KÝ ỨC
      </h1>
      <p class="text-xs sm:text-sm text-gold-100 max-w-2xl mx-auto leading-relaxed">
        Lưu giữ ký ức của các thế hệ cha anh, nhân chứng lịch sử và việc tốt của tuổi trẻ hôm nay. Hỗ trợ chọn file, kéo thả hoặc dán ảnh trực tiếp từ bộ nhớ tạm (Ctrl+V).
      </p>
    </div>
  </section>

  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Form gửi tương tác thực tế 100% -->
    <StorySubmitForm client:load />
  </main>

</RootLayout>
