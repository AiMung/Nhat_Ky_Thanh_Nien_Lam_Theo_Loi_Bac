---
import RootLayout from '@/layouts/RootLayout.astro';
import StorySubmitForm from '@/components/story/StorySubmitForm';
---

<RootLayout title="Gửi Nhật Ký Ký Ức - Đề án Thành Đoàn TP. Hồ Chí Minh">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <div class="text-center max-w-2xl mx-auto mb-10">
      <span class="text-xs font-bold text-redflag-800 uppercase tracking-widest bg-redflag-50 px-3 py-1 rounded-full border border-redflag-200">
        Đóng góp tư liệu
      </span>
      <h1 class="font-serif font-black text-3xl sm:text-4xl text-slate-900 mt-2.5 mb-3">
        Viết Nhật Ký Ký Ức Lịch Sử
      </h1>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
        Ghi lại câu chuyện của những nhân chứng, cựu cán bộ Đoàn hoặc việc làm ý nghĩa của chi đoàn bạn để lưu truyền cho thế hệ thanh niên mai sau.
      </p>
    </div>

    <!-- Form gửi tương tác thực tế 100% -->
    <StorySubmitForm client:load />

  </div>
</RootLayout>
