---
import RootLayout from '@/layouts/RootLayout.astro';
import StoryLibraryView from '@/components/story/StoryLibraryView';
import { withBase } from '@/lib/utils';
---

<RootLayout title="Thư viện Nhật Ký Ký Ức - Thành Đoàn TP. Hồ Chí Minh">
  
  <!-- Banner tiêu đề chuẩn Enterprise: Sáng sủa, trang trọng, thanh lịch -->
  <section class="bg-gradient-to-b from-white via-slate-50 to-slate-100/80 border-b border-slate-200 py-10 px-4">
    <div class="max-w-7xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 text-xs text-slate-500 font-semibold mb-2.5 uppercase tracking-wider">
        <a href={withBase('/')} class="hover:text-red-700 transition-colors">Trang chủ</a>
        <span>/</span>
        <span class="text-red-700 font-bold">Thư viện ký ức</span>
      </div>

      <h1 class="font-serif font-bold text-2xl sm:text-4xl text-slate-900 tracking-tight leading-tight mb-2">
        THƯ VIỆN KÝ ỨC & NHẬT KÝ THANH NIÊN
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Tra cứu hàng ngàn trang hồi ức, chiến công hào hùng và những việc làm bình dị mà cao quý của tuổi trẻ qua các thời kỳ lịch sử.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Component bộ lọc & tìm kiếm tương tác thật 100% -->
    <StoryLibraryView client:load />
  </div>

</RootLayout>
