---
import RootLayout from '@/layouts/RootLayout.astro';
import StoryLibraryView from '@/components/story/StoryLibraryView';
---

<RootLayout title="Thư viện Nhật Ký Ký Ức - Thành Đoàn TP. Hồ Chí Minh">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Tiêu đề trang trọng -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <span class="text-xs font-bold text-doan-800 uppercase tracking-widest bg-doan-50 px-3 py-1 rounded-full border border-doan-200">
        Kho tư liệu truyền thống
      </span>
      <h1 class="font-serif font-black text-3xl sm:text-4xl text-slate-900 mt-2.5 mb-3">
        Thư Viện Nhật Ký Thanh Niên
      </h1>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
        Tra cứu hàng ngàn trang hồi ức, chiến công và việc làm ý nghĩa của thanh niên TP. Hồ Chí Minh qua các thời kỳ lịch sử.
      </p>
    </div>

    <!-- Component bộ lọc & tìm kiếm tương tác thật 100% -->
    <StoryLibraryView client:load />

  </div>
</RootLayout>
