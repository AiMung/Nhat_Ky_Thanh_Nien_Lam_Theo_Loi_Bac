---
import RootLayout from '@/layouts/RootLayout.astro';
import StoryLibraryView from '@/components/story/StoryLibraryView';
import { withBase } from '@/lib/utils';
---

<RootLayout title="Thư viện Nhật Ký Ký Ức - Thành Đoàn TP. Hồ Chí Minh">
  
  <!-- Banner tiêu đề trang Thời Hoa Lửa -->
  <section class="relative bg-gradient-hero text-white py-14 px-4 border-b-4 border-gold-500 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/images/thoi-hoa-lua/hero-thu-vien.jpg"
        alt="Thư viện ký ức lịch sử"
        class="w-full h-full object-cover opacity-30 filter contrast-125"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-doan-950/95 via-redflag-950/85 to-doan-950/90"></div>
    </div>

    <div class="max-w-7xl mx-auto relative z-10 text-center">
      <div class="inline-flex items-center gap-2 text-xs text-gold-300 font-bold mb-3 uppercase tracking-wider bg-slate-950/70 px-3.5 py-1 rounded-full border border-gold-500/40">
        <a href={withBase('/')} class="hover:underline">Trang chủ</a>
        <span>/</span>
        <span class="text-white">Thư viện ký ức</span>
      </div>

      <h1 class="font-serif font-black text-2xl sm:text-4xl text-white tracking-tight leading-tight mb-2">
        THƯ VIỆN KÝ ỨC & NHẬT KÝ THANH NIÊN
      </h1>
      <p class="text-xs sm:text-sm text-gold-100 max-w-2xl mx-auto leading-relaxed">
        Tra cứu hàng ngàn trang hồi ức, chiến công hào hùng và những việc làm bình dị mà cao quý của tuổi trẻ qua các thời kỳ lịch sử.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Component bộ lọc & tìm kiếm tương tác thật 100% -->
    <StoryLibraryView client:load />
  </div>

</RootLayout>
