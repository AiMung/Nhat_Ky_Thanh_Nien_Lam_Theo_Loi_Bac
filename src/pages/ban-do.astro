---
import RootLayout from '@/layouts/RootLayout.astro';
import { withBase } from '@/lib/utils';
---

<RootLayout title="Địa chỉ Đỏ & Di tích Lịch sử Phường Xuân Hương — Đà Lạt">
  <head>
    <meta http-equiv="refresh" content={`0;url=${withBase('/dia-chi-do')}`} />
  </head>
  <div class="min-h-[500px] flex items-center justify-center p-6 text-center">
    <div class="max-w-md mx-auto py-16">
      <div class="w-16 h-16 rounded-full bg-red-50 text-red-700 flex items-center justify-center text-2xl mx-auto mb-4 border border-red-200">
        📍
      </div>
      <h1 class="font-serif font-black text-2xl text-slate-900 mb-2">
        Địa Chỉ Đỏ & Di Tích Lịch Sử Đà Lạt
      </h1>
      <p class="text-xs text-slate-600 mb-6">
        Đang chuyển hướng bạn đến trang Di tích Lịch sử & Địa chỉ Đỏ Phường Xuân Hương — Đà Lạt...
      </p>
      <a
        href={withBase('/dia-chi-do')}
        class="px-5 py-2.5 rounded-xl bg-red-700 hover:bg-red-800 text-white font-bold text-xs shadow transition-colors"
      >
        Khám phá ngay →
      </a>
    </div>
  </div>
</RootLayout>
