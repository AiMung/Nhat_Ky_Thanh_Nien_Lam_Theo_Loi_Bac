---
import RootLayout from '@/layouts/RootLayout.astro';
import VietnamMap from '@/components/map/VietnamMap';
import { withBase } from '@/lib/utils';
---

<RootLayout title="Bản đồ Địa chỉ Đỏ & Ký ức Lịch sử - Thành Đoàn TP. Hồ Chí Minh">
  
  <!-- Banner tiêu đề chuẩn Enterprise: Sáng sủa, trang trọng, thanh lịch -->
  <section class="bg-gradient-to-b from-white via-slate-50 to-slate-100/80 border-b border-slate-200 py-10 px-4">
    <div class="max-w-7xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 text-xs text-slate-500 font-semibold mb-2.5 uppercase tracking-wider">
        <a href={withBase('/')} class="hover:text-red-700 transition-colors">Trang chủ</a>
        <span>/</span>
        <span class="text-red-700 font-bold">Bản đồ Địa chỉ Đỏ</span>
      </div>

      <h1 class="font-serif font-bold text-2xl sm:text-4xl text-slate-900 tracking-tight leading-tight mb-2">
        BẢN ĐỒ KÝ ỨC LỊCH SỬ & ĐỊA CHỈ ĐỎ
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Theo chân các thế hệ thanh niên khám phá các chiến tích hào hùng, khẳng định trọn vẹn chủ quyền thiêng liêng đối với hai quần đảo Hoàng Sa và Trường Sa.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <VietnamMap client:only="react" />
  </div>

</RootLayout>
