---
import RootLayout from '@/layouts/RootLayout.astro';
import { withBase } from '@/lib/utils';

const MILESTONES = [
  {
    year: '1931',
    title: 'Thành lập Đoàn TNCS Đông Dương (nay là Đoàn TNCS Hồ Chí Minh)',
    desc: 'Ngày 26/3/1931, Hội nghị BCH Trung ương Đảng lần thứ 2 đã quyết định thành lập tổ chức Đoàn, đánh dấu bước ngoặt lịch sử của phong trào thanh niên cách mạng Việt Nam.',
    period: '1945-truoc',
    badge: 'Mốc son ra đời',
    img: '/images/thoi-hoa-lua/story-1.jpg'
  },
  {
    year: '1954',
    title: 'Chiến thắng Điện Biên Phủ "Lừng lẫy năm châu, chấn động địa cầu"',
    desc: 'Thiên anh hùng ca vĩ đại của dân tộc ghi dấu ấn tuổi mười chín đôi mươi của các chiến sĩ Điện Biên bạt núi, kéo pháo, đập tan tập đoàn cứ điểm thực dân.',
    period: '1945-1954',
    badge: 'Kỳ tích Điện Biên',
    img: '/images/thoi-hoa-lua/story-chien-dich-dien-bien-phu.jpg'
  },
  {
    year: '1968',
    title: 'Cuộc Tổng tiến công Xuân Mậu Thân & Biệt động Sài Gòn',
    desc: 'Thanh niên, học sinh, sinh viên và các chiến sĩ Biệt động Sài Gòn đã lập nên những kỳ tích chấn động, tấn công các mục tiêu đầu não của đối phương giữa đô thành.',
    period: '1955-1975',
    badge: 'Bão lửa Mậu Thân',
    img: '/images/thoi-hoa-lua/cat-khang-chien.jpg'
  },
  {
    year: '1972',
    title: 'Hà Nội 12 ngày đêm Điện Biên Phủ trên không kiên cường',
    desc: 'Quân và dân Thủ đô bắn rơi hàng chục pháo đài bay B-52, đập tan cuộc tập kích đường không chiến lược của đế quốc, mở đường cho ngày toàn thắng.',
    period: '1955-1975',
    badge: 'Hà Nội 12 ngày đêm',
    img: '/images/thoi-hoa-lua/story-ha-noi-12-ngay-dem.jpg'
  },
  {
    year: '1975',
    title: 'Đại thắng Mùa Xuân 1975 - Sài Gòn hoàn toàn giải phóng',
    desc: 'Chiến dịch Hồ Chí Minh lịch sử toàn thắng. Tuổi trẻ Sài Gòn hân hoan đón đoàn quân giải phóng, tiếp quản và chung tay xây dựng lại thành phố thân yêu.',
    period: '1955-1975',
    badge: 'Non sông liền một dải',
    img: '/images/thoi-hoa-lua/timeline-1975.jpg'
  },
  {
    year: '1976',
    title: 'Lực lượng TNXP TP.HCM xuất quân hồi sinh Rừng Sác Cần Giờ',
    desc: 'Hàng vạn thanh niên xung phong thành phố lên đường khai hoang, phục hồi màu xanh cho Rừng Sác Cần Giờ - biến vùng đất chết thành Khu Dự trữ Sinh quyển Thế giới.',
    period: '1975-1988',
    badge: 'Hồi sinh màu xanh',
    img: '/images/thoi-hoa-lua/cat-bien-gioi.jpg'
  },
  {
    year: '1988',
    title: 'Vòng tròn bất tử Gạc Ma - Quyết tử bảo vệ chủ quyền Biển đảo',
    desc: '64 chiến sĩ Hải quân nhân dân Việt Nam anh dũng kết thành vòng tròn bất tử trên rạn đá Gạc Ma, khẳng định chủ quyền thiêng liêng bất khả xâm phạm của Tổ quốc.',
    period: '1975-1988',
    badge: 'Vòng tròn bất tử',
    img: '/images/truong-sa-chu-quyen.jpg'
  },
  {
    year: '1994 - Nay',
    title: 'Chiến dịch Tình nguyện Mùa Hè Xanh & Chuyển đổi số',
    desc: 'Từ phong trào "Ánh sáng văn hóa hè" đã nhân rộng thành chiến dịch Mùa Hè Xanh huyền thoại mang thương hiệu tuổi trẻ TP.HCM, nay tiên phong số hóa 100 Địa chỉ Đỏ.',
    period: '1989-nay',
    badge: 'Khát vọng tương lai',
    img: '/images/thoi-hoa-lua/story-me-va-nhung-la-thu.jpg'
  }
];
---

<RootLayout title="Những mốc son lịch sử Tuổi trẻ - Nhật Ký Làm Theo Lời Bác">
  
  <!-- Hero Banner Dòng thời gian với ảnh tư liệu lịch sử hào hùng -->
  <section 
    class="relative text-white py-14 sm:py-20 px-4 border-b-4 border-amber-500 overflow-hidden shadow-hero"
    style="background-image: linear-gradient(to bottom, rgba(15, 23, 42, 0.85), rgba(15, 23, 42, 0.94)), url('/images/thoi-hoa-lua/hero-sukien.jpg'); background-size: cover; background-position: center;"
  >
    <div class="absolute inset-0 bg-gradient-to-r from-red-950/60 via-transparent to-black/60 pointer-events-none"></div>

    <div class="max-w-5xl mx-auto text-center relative z-10">
      <div class="inline-flex items-center gap-2 text-xs font-bold text-amber-300 bg-black/60 px-4 py-1.5 rounded-full border border-amber-400/50 mb-3 shadow-lg">
        <a href={withBase('/')} class="hover:text-white transition-colors">Trang chủ</a>
        <span>/</span>
        <span class="text-amber-400 uppercase tracking-wider">Mốc son lịch sử của Đoàn</span>
      </div>

      <h1 class="font-serif font-black text-3xl sm:text-5xl text-white tracking-tight leading-tight mb-3 drop-shadow-[0_4px_16px_rgba(0,0,0,0.8)]">
        NHỮNG MỐC SON LỊCH SỬ HÀO HÙNG CỦA DÂN TỘC
      </h1>
      <p class="text-xs sm:text-base text-amber-100 max-w-2xl mx-auto leading-relaxed drop-shadow font-medium">
        Hành trình hơn 90 năm rèn luyện, cống hiến và chiến đấu vẻ vang của các thế hệ thanh niên dưới ngọn cờ của Đảng và Bác Hồ muôn vàn kính yêu.
      </p>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Dòng thời gian trực quan có ảnh -->
    <div class="relative border-l-2 border-doan-700 ml-4 sm:ml-36 space-y-12 pb-10">
      {MILESTONES.map((m) => (
        <div class="relative pl-6 sm:pl-8 group">
          
          <!-- Nốt chấm sao vàng -->
          <div class="absolute -left-[11px] top-1.5 w-5 h-5 rounded-full bg-redflag-700 border-4 border-white shadow-md flex items-center justify-center text-[8px] text-gold-300 font-bold group-hover:scale-125 transition-transform">
            ★
          </div>

          <!-- Năm mốc son bên lề -->
          <div class="sm:absolute sm:-left-36 sm:top-0 sm:w-28 sm:text-right font-serif font-black text-xl sm:text-2xl text-doan-900">
            {m.year}
          </div>

          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-card-hover transition-all overflow-hidden p-6 flex flex-col sm:flex-row gap-6">
            <img
              src={m.img}
              alt={m.title}
              class="w-full sm:w-44 h-32 object-cover rounded-xl shrink-0 border border-slate-100"
            />

            <div class="flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-[10px] font-bold text-redflag-800 bg-redflag-50 px-2 py-0.5 rounded border border-redflag-200 uppercase tracking-wider">
                    {m.badge}
                  </span>
                </div>

                <h3 class="font-serif font-bold text-lg sm:text-xl text-slate-900 group-hover:text-doan-800 transition-colors mb-2">
                  {m.title}
                </h3>

                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  {m.desc}
                </p>
              </div>

              <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
                <a
                  href={withBase(`/thu-vien?period=${m.period}`)}
                  class="text-xs font-bold text-doan-800 hover:text-redflag-700 flex items-center gap-1 transition-colors"
                >
                  <span>Xem câu chuyện thời kỳ này</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </div>

        </div>
      ))}
    </div>
  </div>
</RootLayout>
