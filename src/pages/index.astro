---
import RootLayout from '@/layouts/RootLayout.astro';
import SearchBar from '@/components/search/SearchBar';
import EmberSparks from '@/components/common/EmberSparks';
import FeaturedStoryCarousel from '@/components/home/FeaturedStoryCarousel';
import InteractiveTimelineGsap from '@/components/home/InteractiveTimelineGsap';
import LeaderboardSection from '@/components/home/LeaderboardSection';
import { getAllStories } from '@/lib/storage';
import { withBase } from '@/lib/utils';

// Lấy danh sách câu chuyện đã duyệt
const allStories = getAllStories();
const approvedStories = allStories.filter((s) => s.status === 'approved');
const recentStories = approvedStories.slice(0, 3);

// 6 Chủ đề câu chuyện chuẩn ảnh Screenshot 3 (Thời Hoa Lửa)
const CATEGORIES = [
  { 
    id: 'anh-hung-llvt',
    name: 'Anh hùng Lực lượng vũ trang', 
    count: '316.523', 
    img: '/images/truong-sa-chu-quyen.jpg'
  },
  { 
    id: 'cuu-chien-binh',
    name: 'Cựu chiến binh & Nhân chứng', 
    count: '219.065', 
    img: '/images/thoi-hoa-lua/cat-khang-chien.jpg'
  },
  { 
    id: 'phong-trao-doan',
    name: 'Tuổi trẻ Phường Xuân Hương', 
    count: '155.927', 
    img: '/images/thoi-hoa-lua/sk-tin1.jpg'
  },
  { 
    id: 'me-viet-nam-anh-hung',
    name: 'Mẹ Việt Nam Anh hùng', 
    count: '95.005', 
    img: '/images/thoi-hoa-lua/story-me-va-nhung-la-thu.jpg'
  },
  { 
    id: 'nhan-chung-su-kien',
    name: 'Nhân chứng trực tiếp các sự kiện', 
    count: '86.798', 
    img: '/images/thoi-hoa-lua/cat-bien-gioi.jpg'
  },
  { 
    id: 'nguoi-co-cong',
    name: 'Người có công giúp đỡ cách mạng', 
    count: '64.466', 
    img: '/images/thoi-hoa-lua/story-chiec-vong-bac.jpg'
  },
];
---

<RootLayout title="Nhật Ký Thanh Niên Làm Theo Lời Bác — Phường Xuân Hương, Đà Lạt">
  
  <!-- ================= 1. HERO BANNER THỜI HOA LỬA (CHUẨN SCREENSHOT 1) ================= -->
  <section class="relative text-white py-16 sm:py-24 px-4 overflow-hidden border-b-4 border-amber-500 shadow-hero min-h-[580px] lg:min-h-[640px] flex items-center">
    
    {/* Hình nền cờ Tổ quốc & Chân dung lịch sử hào hùng */}
    <div class="absolute inset-0 z-0">
      <img
        src={withBase('/images/hero-official.jpg')}
        alt="Nhật ký thanh niên làm theo lời Bác"
        class="w-full h-full object-cover object-center filter brightness-90 contrast-105"
      />
      {/* Lớp phủ chuyển màu đỏ - than nghệ thuật */}
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/40 to-black/30 lg:bg-gradient-to-r lg:from-slate-950/90 lg:via-slate-950/50 lg:to-black/20"></div>
    </div>

    {/* Hiệu ứng tàn lửa hoa lửa bập bùng (Ember Sparks) */}
    <EmberSparks client:load />
    
    <div class="max-w-7xl mx-auto relative z-10 w-full py-4">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        {/* Cột trái: Tiêu đề lớn & Khẩu hiệu hành động chuẩn Screenshot 1 */}
        <div class="lg:col-span-7 text-center lg:text-left space-y-4">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-950/80 backdrop-blur-md border border-amber-400/60 text-amber-300 text-xs font-bold shadow-xl">
            <span class="text-amber-400">★</span>
            <span class="tracking-wide">ĐOÀN TNCS HỒ CHÍ MINH PHƯỜNG XUÂN HƯƠNG — ĐÀ LẠT</span>
            <span class="text-amber-400">★</span>
          </div>

          <h1 class="font-serif font-black text-3xl sm:text-5xl lg:text-6xl text-white tracking-tight leading-tight drop-shadow-xl">
            Mỗi nhân chứng <br />
            là một <span class="text-amber-300 drop-shadow-[0_4px_20px_rgba(245,158,11,0.6)]">trang sử sống</span>
          </h1>

          <p class="text-sm sm:text-base text-amber-100/90 font-medium leading-relaxed max-w-xl mx-auto lg:mx-0 drop-shadow-md">
            Lưu giữ ký ức của dân tộc Việt Nam qua những câu chuyện được chính nhân chứng, cựu chiến binh và cộng đồng 37 Tổ Dân Phố Phường Xuân Hương kể lại.
          </p>

          <div class="pt-2 flex flex-wrap items-center justify-center lg:justify-start gap-3.5">
            <a 
              href={withBase('/thu-vien')} 
              class="inline-flex items-center gap-2 bg-gradient-to-r from-red-700 to-red-800 hover:from-red-800 hover:to-red-900 text-amber-100 px-6 py-3.5 rounded-full text-xs sm:text-sm font-bold shadow-xl transition-transform hover:scale-105"
            >
              <span>Khám phá câu chuyện</span>
              <span>→</span>
            </a>
            <a 
              href={withBase('/gui-cau-chuyen')} 
              class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 border-2 border-white/40 text-white px-6 py-3.5 rounded-full text-xs sm:text-sm font-bold transition-all backdrop-blur shadow-md hover:border-amber-300"
            >
              <span>Gửi câu chuyện</span>
              <span>→</span>
            </a>
          </div>
        </div>

        {/* Cột phải: Thanh tìm kiếm & Hộp trích dẫn lời Bác */}
        <div class="lg:col-span-5 space-y-3.5">
          <div class="p-4 sm:p-5 rounded-3xl bg-red-950/80 backdrop-blur-md border border-amber-400/40 text-amber-100 shadow-2xl">
            <div class="flex items-start gap-3">
              <span class="text-3xl text-amber-300 leading-none select-none">“</span>
              <div class="flex-1">
                <p class="font-serif italic text-sm sm:text-base text-amber-200 leading-relaxed font-semibold">
                  Không có việc gì khó, chỉ sợ lòng không bền<br class="hidden sm:inline" />
                  Đào núi và lấp biển, quyết chí ắt làm nên.
                </p>
                <div class="text-[11px] text-amber-300 font-bold uppercase tracking-wider mt-1.5 flex items-center gap-1.5">
                  <span>★</span>
                  <span>Lời Bác Hồ tặng Đội TNXP (1951)</span>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-white/95 backdrop-blur-md p-1.5 rounded-2xl shadow-xl border border-white/40">
            <SearchBar client:load />
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* ================= 2. CAROUSEL CÂU CHUYỆN NỔI BẬT (CHUẨN SCREENSHOT 2) ================= */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
    <FeaturedStoryCarousel client:load stories={approvedStories} />
  </section>

  {/* ================= 3. CHỦ ĐỀ CÂU CHUYỆN (CHUẨN SCREENSHOT 3) ================= */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <div class="flex items-center justify-between mb-6 pb-2 border-b border-amber-200/60">
      <h2 class="font-serif font-black text-2xl sm:text-3xl text-slate-900 tracking-tight">
        Chủ đề câu chuyện
      </h2>
      <a 
        href={withBase('/thu-vien')} 
        class="text-xs sm:text-sm font-bold text-red-700 hover:text-red-800 flex items-center gap-1 hover:underline"
      >
        <span>Xem tất cả</span>
        <span>→</span>
      </a>
    </div>

    {/* Hàng 6 thẻ dựng đứng (Portrait Aspect-[3/4]) bo tròn tone sepia chuẩn Screenshot 3 */}
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 sm:gap-5">
      {CATEGORIES.map((cat) => (
        <a 
          href={withBase(`/thu-vien?cat=${cat.id}`)} 
          class="group rounded-3xl overflow-hidden flex flex-col bg-slate-900 border border-amber-200/80 shadow-xs hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 relative aspect-[3/4]"
        >
          <img 
            src={cat.img} 
            alt={cat.name} 
            loading="lazy" 
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 filter sepia-[0.35] brightness-90 contrast-105" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent"></div>
          
          {/* Thông tin ở đáy thẻ */}
          <div class="absolute bottom-3.5 left-3.5 right-3.5 text-white">
            <h3 class="font-serif font-bold text-xs sm:text-sm text-white leading-tight group-hover:text-amber-200 transition-colors drop-shadow">
              {cat.name}
            </h3>
            <span class="text-[10px] sm:text-[11px] font-bold text-amber-300 uppercase tracking-wider block mt-1 drop-shadow">
              {cat.count} câu chuyện
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  {/* ================= 4. DÒNG CHẢY LỊCH SỬ (CHUẨN SCREENSHOT 4) ================= */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <div class="mb-6 pb-2 border-b border-amber-200/60">
      <h2 class="font-serif font-black text-2xl sm:text-3xl text-slate-900 tracking-tight">
        Dòng chảy lịch sử
      </h2>
    </div>

    <InteractiveTimelineGsap client:load />
  </section>

  {/* ================= 5. NHỮNG CÂU CHUYỆN MỚI (CHUẨN SCREENSHOT 5) ================= */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <div class="flex items-center justify-between mb-8 pb-2 border-b border-amber-200/60">
      <h2 class="font-serif font-black text-2xl sm:text-3xl text-slate-900 tracking-tight">
        Những câu chuyện mới
      </h2>
      <a 
        href={withBase('/thu-vien')} 
        class="text-xs sm:text-sm font-bold text-red-700 hover:text-red-800 flex items-center gap-1 hover:underline"
      >
        <span>Xem tất cả</span>
        <span>→</span>
      </a>
    </div>

    {/* Lưới 3 thẻ câu chuyện mới chuẩn Screenshot 5 */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {recentStories.map((story) => (
        <article class="group bg-[#FAF6F0] rounded-3xl overflow-hidden border border-amber-200/80 shadow-xs hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col">
          {/* Ảnh trên aspect-[16/10] */}
          <div class="aspect-[16/10] overflow-hidden bg-slate-900 relative">
            <img 
              src={story.cover_url || '/images/thoi-hoa-lua-hero.jpg'} 
              alt={story.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 filter brightness-95" 
            />
          </div>

          {/* Nội dung bên dưới */}
          <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between space-y-3">
            <div>
              <span class="text-[10px] font-black uppercase tracking-widest text-red-800 block mb-1">
                {story.category_name}
              </span>
              <h3 class="font-serif font-bold text-base sm:text-lg text-slate-900 leading-snug group-hover:text-red-700 transition-colors line-clamp-2">
                <a href={withBase(`/truyen/chi-tiet?slug=${story.slug}`)}>
                  {story.title}
                </a>
              </h3>
            </div>

            {/* Avatar và thông tin tác giả */}
            <div class="pt-3 border-t border-amber-200/60 flex items-center gap-2.5 text-xs text-slate-500">
              <div class="w-7 h-7 rounded-full bg-amber-200/70 text-amber-900 flex items-center justify-center font-bold text-xs shrink-0">
                👤
              </div>
              <div class="truncate">
                <div class="font-bold text-slate-800 truncate">
                  {story.narrator_name}
                </div>
                <div class="text-[11px] text-slate-400">
                  {story.to_dan_pho || 'Phường Xuân Hương'} • ~{story.read_minutes} phút đọc
                </div>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  {/* ================= 6. BẢNG XẾP HẠNG 37 TỔ DÂN PHỐ ================= */}
  <section id="bang-xep-hang" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <LeaderboardSection client:load />
  </section>

  {/* ================= 7. THỐNG KÊ & BANNER KÊU GỌI (CHUẨN SCREENSHOT 6) ================= */}
  <section class="mt-12">
    {/* Dải 4 thống kê nền đỏ thẫm */}
    <div class="bg-gradient-to-r from-red-800 via-red-700 to-red-900 text-amber-100 py-10 px-4 border-y border-amber-500/40">
      <div class="max-w-6xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <div class="font-serif font-black text-3xl sm:text-4xl text-amber-300">1,8M+</div>
          <div class="text-xs uppercase tracking-wider font-bold mt-1 text-amber-100">Câu chuyện</div>
        </div>
        <div>
          <div class="font-serif font-black text-3xl sm:text-4xl text-amber-300">297K+</div>
          <div class="text-xs uppercase tracking-wider font-bold mt-1 text-amber-100">Nhân chứng</div>
        </div>
        <div>
          <div class="font-serif font-black text-3xl sm:text-4xl text-amber-300">37</div>
          <div class="text-xs uppercase tracking-wider font-bold mt-1 text-amber-100">Tổ Dân Phố P. Xuân Hương</div>
        </div>
        <div>
          <div class="font-serif font-black text-3xl sm:text-4xl text-amber-300">100%</div>
          <div class="text-xs uppercase tracking-wider font-bold mt-1 text-amber-100">Xác thực chuẩn</div>
        </div>
      </div>
    </div>

    {/* Khối Banner Gỗ ấm áp & Nút gửi câu chuyện */}
    <div class="relative bg-stone-950 py-16 sm:py-20 px-4 overflow-hidden text-white">
      <div class="absolute inset-0 z-0 opacity-40">
        <img
          src={withBase('/images/vintage-footer-bg.jpg')}
          alt="Bút tích thời hoa lửa"
          class="w-full h-full object-cover filter contrast-125"
        />
      </div>

      <div class="max-w-4xl mx-auto relative z-10 text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-8">
        <div class="space-y-3">
          <h3 class="font-serif font-black text-2xl sm:text-3xl text-amber-200 leading-snug">
            Bạn cũng đang lưu giữ một câu chuyện lịch sử?
          </h3>
          <p class="text-sm text-amber-100/80 max-w-lg leading-relaxed">
            Hãy chia sẻ để ký ức không bao giờ bị lãng quên. Mỗi hồi ức của bạn là một đóng góp quý giá cho thế hệ mai sau.
          </p>
        </div>

        <a
          href={withBase('/gui-cau-chuyen')}
          class="shrink-0 px-8 py-3.5 rounded-full bg-gradient-to-r from-red-700 to-red-800 hover:from-red-800 hover:to-red-900 text-amber-100 font-bold text-sm shadow-xl transition-transform hover:scale-105"
        >
          <span>Gửi câu chuyện của bạn</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </section>

</RootLayout>
