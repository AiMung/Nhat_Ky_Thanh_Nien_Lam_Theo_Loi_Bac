---
import RootLayout from '@/layouts/RootLayout.astro';
import StoryCard from '@/components/story/StoryCard.astro';
import SearchBar from '@/components/search/SearchBar';
import VietnamMap from '@/components/map/VietnamMap';
import { getAllStories } from '@/lib/storage';
import { withBase } from '@/lib/utils';

// Lấy danh sách câu chuyện đã duyệt
const allStories = getAllStories();
const approvedStories = allStories.filter((s) => s.status === 'approved');
const featuredStory = approvedStories[0] || allStories[0];
const recentStories = approvedStories.slice(1, 4);

// 6 Chủ đề trọng tâm công tác Đoàn & Thanh niên làm theo lời Bác
const CATEGORIES = [
  { 
    id: 'phong-trao-doan',
    name: 'Ký ức Thành Đoàn & Kháng chiến', 
    count: '3,450', 
    img: 'https://images.unsplash.com/photo-1583417319070-4a69db38a482?auto=format&fit=crop&w=600&q=80',
    desc: 'Phong trào HSSV Sài Gòn - Gia Định'
  },
  { 
    id: 'thanh-nien-xung-phong',
    name: 'Thanh niên Xung phong kiên cường', 
    count: '2,890', 
    img: 'https://images.unsplash.com/photo-1542273917363-3b1817f69a2d?auto=format&fit=crop&w=600&q=80',
    desc: 'Mở đường Trường Sơn, hồi sinh Rừng Sác'
  },
  { 
    id: 'tinh-nguyen',
    name: 'Tình nguyện vì cộng đồng', 
    count: '5,120', 
    img: 'https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?auto=format&fit=crop&w=600&q=80',
    desc: '30 năm Mùa hè xanh, Kỳ nghỉ hồng'
  },
  { 
    id: 'bien-dao',
    name: 'Bảo vệ chủ quyền Biển đảo', 
    count: '1,780', 
    img: 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=600&q=80',
    desc: 'Tuổi trẻ vì Trường Sa & Nhà giàn DK1'
  },
  { 
    id: 'hoc-tap-bac',
    name: 'Học tập & Làm theo lời Bác', 
    count: '4,630', 
    img: 'https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?auto=format&fit=crop&w=600&q=80',
    desc: 'Gương sáng thanh niên tiên tiến'
  },
  { 
    id: 'cong-trinh-thanh-nien',
    name: 'Công trình Thanh niên thời đại số', 
    count: '2,100', 
    img: 'https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&w=600&q=80',
    desc: 'Số hóa Địa chỉ Đỏ, đổi mới sáng tạo'
  },
];

// Dòng thời gian các mốc son
const TIMELINE_MILESTONES = [
  { year: '1931', title: 'Thành lập Đoàn TNCS Đông Dương (Đoàn TNCS Hồ Chí Minh)', period: '1945-truoc' },
  { year: '1950', title: 'Anh Trần Văn Ơn anh dũng hy sinh - Ngày HSSV toàn quốc 9/1', period: '1945-1954' },
  { year: '1968', title: 'Phong trào HSSV và Biệt động Sài Gòn trong Tết Mậu Thân', period: '1955-1975' },
  { year: '1975', title: 'Chiến dịch Hồ Chí Minh - Tuổi trẻ tiếp quản và dựng xây Sài Gòn', period: '1955-1975' },
  { year: '1976', title: 'Thành lập Lực lượng TNXP TP. Hồ Chí Minh khai hoang Rừng Sác', period: '1975-1988' },
  { year: '1994', title: 'Chiến dịch "Ánh sáng văn hóa hè" - Khởi đầu Mùa Hè Xanh huyền thoại', period: '1989-nay' },
  { year: 'Nay', title: 'Tuổi trẻ TP.HCM tiên phong chuyển đổi số và hội nhập quốc tế', period: '1989-nay' },
];
---

<RootLayout title="Nhật Ký Thanh Niên Làm Theo Lời Bác - Thành Đoàn TP. Hồ Chí Minh">
  
  <!-- HERO BANNER TRANG TRỌNG & RỰC RỠ SẮC MÀU TUỔI TRẺ -->
  <section class="relative bg-gradient-hero text-white py-20 sm:py-28 px-4 overflow-hidden border-b-4 border-gold-500 shadow-hero">
    <!-- Họa tiết sao vàng và tia sáng chiếu rọi -->
    <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#F59E0B_1.5px,transparent_1.5px)] [background-size:28px_28px]"></div>
    
    <div class="max-w-6xl mx-auto text-center relative z-10">
      
      <!-- Badge Đơn vị chỉ đạo -->
      <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-slate-900/80 backdrop-blur border border-gold-400/40 text-gold-300 text-xs sm:text-sm font-bold mb-6 shadow-lg">
        <span class="text-gold-400">★</span>
        <span>ĐOÀN TNCS HỒ CHÍ MINH THÀNH PHỐ HỒ CHÍ MINH</span>
        <span class="text-gold-400">★</span>
      </div>

      <!-- Tiêu đề lớn đầy khí thế -->
      <h1 class="font-serif font-black text-3xl sm:text-5xl lg:text-6xl text-white tracking-tight leading-tight mb-6">
        NHẬT KÝ THANH NIÊN <br />
        <span class="text-gold-400 drop-shadow-md">LÀM THEO LỜI BÁC</span>
      </h1>

      <!-- Trích dẫn bất hủ của Chủ tịch Hồ Chí Minh -->
      <div class="max-w-3xl mx-auto mb-10 p-5 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 text-gold-100 shadow-xl">
        <p class="font-serif italic text-base sm:text-xl leading-relaxed">
          "Không có việc gì khó, chỉ sợ lòng không bền<br class="hidden sm:inline" />
          Đào núi và lấp biển, quyết chí ắt làm nên."
        </p>
        <div class="text-xs sm:text-sm text-gold-300 font-bold uppercase tracking-widest mt-2">
          — Chủ tịch Hồ Chí Minh dặn dò thanh niên xung phong (1951) —
        </div>
      </div>

      <!-- Thanh tìm kiếm không dấu thời gian thực -->
      <div class="max-w-3xl mx-auto mb-12">
        <SearchBar client:load />
      </div>

      <!-- Bốn con số ấn tượng khẳng định sức sống phong trào -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 max-w-4xl mx-auto pt-8 border-t border-white/15">
        <div class="p-4 rounded-xl bg-slate-900/60 backdrop-blur border border-white/10">
          <div class="font-serif font-black text-2xl sm:text-4xl text-gold-400">20,000+</div>
          <div class="text-[11px] sm:text-xs text-slate-300 uppercase tracking-wider font-semibold mt-1">Trang nhật ký đã lưu</div>
        </div>
        <div class="p-4 rounded-xl bg-slate-900/60 backdrop-blur border border-white/10">
          <div class="font-serif font-black text-2xl sm:text-4xl text-gold-400">800+</div>
          <div class="text-[11px] sm:text-xs text-slate-300 uppercase tracking-wider font-semibold mt-1">Cơ sở Đoàn đồng hành</div>
        </div>
        <div class="p-4 rounded-xl bg-slate-900/60 backdrop-blur border border-white/10">
          <div class="font-serif font-black text-2xl sm:text-4xl text-gold-400">100</div>
          <div class="text-[11px] sm:text-xs text-slate-300 uppercase tracking-wider font-semibold mt-1">Địa chỉ Đỏ số hóa 3D</div>
        </div>
        <div class="p-4 rounded-xl bg-slate-900/60 backdrop-blur border border-white/10">
          <div class="font-serif font-black text-2xl sm:text-4xl text-gold-400">100%</div>
          <div class="text-[11px] sm:text-xs text-slate-300 uppercase tracking-wider font-semibold mt-1">Xác minh trung thực</div>
        </div>
      </div>

    </div>
  </section>

  <!-- 6 CHỦ ĐỀ CHUYÊN ĐỀ THANH NIÊN LÀM THEO LỜI BÁC -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-xs font-bold text-doan-800 uppercase tracking-widest bg-doan-50 px-3 py-1 rounded-full border border-doan-200">
        Chuyên đề rèn luyện
      </span>
      <h2 class="font-serif font-black text-2xl sm:text-3xl text-slate-900 mt-2.5">
        Các chuyên đề Nhật ký Ký ức
      </h2>
      <p class="text-sm text-slate-600 mt-2">
        Học tập và làm theo tư tưởng, đạo đức, phong cách Hồ Chí Minh qua từng hành động cụ thể của tuổi trẻ
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {CATEGORIES.map((cat) => (
        <a 
          href={withBase('/thu-vien')} 
          class="group youth-card rounded-2xl overflow-hidden flex flex-col"
        >
          <div class="relative h-44 overflow-hidden">
            <img 
              src={cat.img} 
              alt={cat.name} 
              loading="lazy" 
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent"></div>
            <div class="absolute bottom-3 left-4 right-4">
              <span class="text-[11px] font-bold text-gold-300 uppercase tracking-wider bg-doan-900/90 px-2 py-0.5 rounded">
                {cat.count} bài viết
              </span>
            </div>
          </div>
          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-serif font-bold text-lg text-slate-900 group-hover:text-doan-800 transition-colors mb-1">
                {cat.name}
              </h3>
              <p class="text-xs text-slate-500 line-clamp-2">
                {cat.desc}
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-doan-700 font-bold group-hover:text-redflag-700">
              <span>Khám phá chuyên mục</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- BẢN ĐỒ KÝ ỨC & ĐỊA CHỈ ĐỎ CÓ HOÀNG SA - TRƯỜNG SA -->
  <section class="bg-slate-100/70 border-y border-slate-200 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="text-xs font-bold text-redflag-800 uppercase tracking-widest bg-redflag-50 px-3 py-1 rounded-full border border-redflag-200">
          Chủ quyền thiêng liêng
        </span>
        <h2 class="font-serif font-black text-2xl sm:text-3xl text-slate-900 mt-2.5">
          Bản đồ Ký ức Lịch sử & Địa chỉ Đỏ
        </h2>
        <p class="text-sm text-slate-600 mt-2">
          Theo chân những chiến sĩ trẻ và cựu cán bộ Đoàn trên khắp mọi miền Tổ quốc, khẳng định chủ quyền toàn vẹn Hoàng Sa và Trường Sa
        </p>
      </div>

      <VietnamMap client:visible />
    </div>
  </section>

  <!-- DÒNG THỜI GIAN MỐC SON CỦA ĐOÀN VÀ TUỔI TRẺ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-xs font-bold text-doan-800 uppercase tracking-widest bg-doan-50 px-3 py-1 rounded-full border border-doan-200">
        Biên niên sử vàng
      </span>
      <h2 class="font-serif font-black text-2xl sm:text-3xl text-slate-900 mt-2.5">
        Những mốc son lịch sử Tuổi trẻ TP.HCM
      </h2>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3">
      {TIMELINE_MILESTONES.map((item) => (
        <a
          href={withBase('/dong-thoi-gian')}
          class="bg-white p-4 rounded-xl border border-slate-200 hover:border-doan-600 hover:shadow-card-hover transition-all text-center group"
        >
          <div class="font-serif font-black text-xl text-redflag-800 group-hover:scale-105 transition-transform">
            {item.year}
          </div>
          <div class="text-[11px] text-slate-700 font-medium mt-1.5 line-clamp-3 leading-snug">
            {item.title}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- TRUYỆN NỔI BẬT & MỚI NHẤT -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-slate-200">
    <div class="flex items-center justify-between mb-10">
      <div>
        <span class="text-xs font-bold text-redflag-800 uppercase tracking-widest bg-redflag-50 px-3 py-1 rounded-full border border-redflag-200">
          Trang nhật ký mới
        </span>
        <h2 class="font-serif font-black text-2xl sm:text-3xl text-slate-900 mt-2.5">
          Những câu chuyện lay động trái tim
        </h2>
      </div>

      <a 
        href={withBase('/thu-vien')} 
        class="text-xs sm:text-sm font-bold text-doan-800 hover:text-redflag-700 flex items-center gap-1 group bg-doan-50 px-4 py-2 rounded-xl transition-colors"
      >
        <span>Xem toàn bộ thư viện</span>
        <span class="group-hover:translate-x-1 transition-transform">→</span>
      </a>
    </div>

    <!-- Câu chuyện tiêu điểm -->
    {featuredStory && (
      <div class="mb-10">
        <StoryCard story={featuredStory} featured={true} />
      </div>
    )}

    <!-- Danh sách 3 bài viết kế tiếp -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {recentStories.map((story) => (
        <StoryCard story={story} />
      ))}
    </div>
  </section>

  <!-- CALL TO ACTION: ĐOÀN VIÊN VIẾT NHẬT KÝ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="bg-gradient-youth rounded-3xl p-8 sm:p-14 text-white text-center shadow-2xl relative overflow-hidden">
      <div class="relative z-10 max-w-3xl mx-auto">
        <span class="inline-block px-4 py-1.5 rounded-full bg-white/20 backdrop-blur text-gold-300 text-xs font-bold uppercase tracking-wider mb-4">
          Phát động phong trào toàn Thành phố
        </span>
        <h3 class="font-serif font-black text-2xl sm:text-4xl text-white mb-4 leading-tight">
          Mỗi đoàn viên một việc tốt, <br />
          Mỗi chi đoàn một công trình dâng Bác
        </h3>
        <p class="text-sm sm:text-base text-blue-100 leading-relaxed mb-8 max-w-2xl mx-auto">
          Hãy chia sẻ những câu chuyện về tấm gương Bác Hồ bạn đã học tập, hồi ức của thế hệ đi trước hoặc việc làm ý nghĩa của chính chi đoàn bạn.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href={withBase('/gui-cau-chuyen')} 
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-gold-400 hover:bg-gold-500 text-slate-950 font-serif font-black px-8 py-4 rounded-xl shadow-lg transition-transform hover:scale-105"
          >
            <span>Viết nhật ký gửi ngay</span>
            <span>✍️</span>
          </a>
          <a 
            href={withBase('/thu-vien')} 
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 border border-white/30 text-white font-bold px-6 py-4 rounded-xl transition-colors"
          >
            <span>Tra cứu tư liệu</span>
          </a>
        </div>
      </div>
    </div>
  </section>

</RootLayout>
