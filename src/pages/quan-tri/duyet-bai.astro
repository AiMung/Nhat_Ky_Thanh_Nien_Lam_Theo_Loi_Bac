---
import RootLayout from '@/layouts/RootLayout.astro';
import AdminModerationQueue from '@/components/admin/AdminModerationQueue';
---

<RootLayout title="Hàng đợi kiểm duyệt bài viết - Thành Đoàn TP. Hồ Chí Minh">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 pb-6 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold text-redflag-800 uppercase tracking-widest bg-redflag-50 px-3 py-1 rounded-full border border-redflag-200">
            Ban Tuyên giáo Thành Đoàn
          </span>
        </div>
        <h1 class="font-serif font-black text-2xl sm:text-3xl text-slate-900 mt-2">
          Kiểm Duyệt & Xuất Bản Nhật Ký
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Hệ thống phê duyệt hai tầng: Tiền kiểm tư liệu trước khi công bố rộng rãi trên Cổng thông tin
        </p>
      </div>

      <button
        onclick="alert('Đã đồng bộ dữ liệu xuất bản tĩnh lên máy chủ!');"
        class="inline-flex items-center gap-2 bg-gradient-to-r from-redflag-800 to-doan-900 text-white px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold shadow-md hover:shadow-lg transition-all"
      >
        <span>⚡</span>
        <span>Xuất bản ngay (Instant Build)</span>
      </button>
    </div>

    <!-- Hàng đợi kiểm duyệt tương tác thật 100% -->
    <AdminModerationQueue client:load />

  </div>
</RootLayout>
