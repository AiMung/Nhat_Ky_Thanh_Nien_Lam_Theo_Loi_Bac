---
import RootLayout from '@/layouts/RootLayout.astro';
import MyStoriesView from '@/components/story/MyStoriesView';
import { withBase } from '@/lib/utils';
---

<RootLayout title="Quản lý câu chuyện của tôi - Thành Đoàn TP. Hồ Chí Minh">
  
  <!-- Banner tiêu đề trang chuẩn Enterprise -->
  <section class="bg-gradient-to-b from-white via-slate-50 to-slate-100/80 border-b border-slate-200 py-10 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="inline-flex items-center gap-2 text-xs text-slate-500 font-semibold mb-2.5 uppercase tracking-wider">
        <a href={withBase('/')} class="hover:text-red-700 transition-colors">Trang chủ</a>
        <span>/</span>
        <span>Tài khoản cá nhân</span>
        <span>/</span>
        <span class="text-red-700 font-bold">Câu chuyện của tôi</span>
      </div>

      <h1 class="font-serif font-bold text-2xl sm:text-4xl text-slate-900 tracking-tight leading-tight">
        QUẢN LÝ CÂU CHUYỆN & TRANG NHẬT KÝ
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 mt-2 max-w-2xl leading-relaxed">
        Theo dõi trạng thái kiểm duyệt, chỉnh sửa nội dung hoặc bổ sung tư liệu cho những trang ký ức bạn đã gửi gắm.
      </p>
    </div>
  </section>

  <!-- Danh sách câu chuyện kèm Thao tác Thêm - Sửa - Xoá -->
  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <MyStoriesView client:load />
  </main>

</RootLayout>

