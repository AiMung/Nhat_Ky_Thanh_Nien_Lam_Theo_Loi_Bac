---
import RootLayout from '@/layouts/RootLayout.astro';
---

<RootLayout title="Đăng nhập - Đề án Ký Ức Lịch Sử">
  <div class="max-w-md mx-auto px-4 py-16">
    <div class="bg-white p-8 rounded-2xl border border-heritage-200 shadow-sm text-center">
      
      <div class="w-12 h-12 rounded-full bg-redflag-800 flex items-center justify-center text-amber-300 font-serif font-black text-xl mx-auto mb-4 shadow">
        ★
      </div>

      <h1 class="font-serif font-black text-2xl text-heritage-900 mb-2">
        Đăng nhập hệ thống
      </h1>
      <p class="text-xs text-heritage-600 mb-6">
        Dành cho người đóng góp theo dõi bài viết và Ban biên tập kiểm duyệt
      </p>

      <div class="space-y-4">
        <!-- Đăng nhập bằng Google -->
        <button
          onclick="alert('Chức năng Google OAuth sẽ kết nối với Supabase Auth khi bạn điền PUBLIC_SUPABASE_URL.');"
          class="w-full flex items-center justify-center gap-3 py-3 px-4 rounded-xl border border-heritage-300 hover:bg-heritage-50 text-heritage-800 text-sm font-medium transition-colors"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          <span>Tiếp tục với tài khoản Google</span>
        </button>

        <div class="flex items-center gap-3 my-4">
          <div class="h-px flex-1 bg-heritage-200"></div>
          <span class="text-xs text-heritage-400">hoặc</span>
          <div class="h-px flex-1 bg-heritage-200"></div>
        </div>

        <!-- Đăng nhập Magic Link Email -->
        <input
          type="email"
          id="emailInput"
          placeholder="Nhập địa chỉ email của bạn..."
          class="w-full px-4 py-3 rounded-xl border border-heritage-300 text-heritage-900 text-sm focus:ring-2 focus:ring-redflag-700 focus:outline-none"
        />

        <button
          onclick="const email = document.getElementById('emailInput').value; if(email) alert('Đã gửi Magic link đăng nhập vào hộp thư ' + email + '!');"
          class="w-full py-3 px-4 rounded-xl bg-redflag-800 hover:bg-redflag-900 text-amber-100 font-serif font-bold text-sm shadow transition-colors"
        >
          Gửi Magic link đăng nhập qua Email
        </button>
      </div>

    </div>
  </div>
</RootLayout>

