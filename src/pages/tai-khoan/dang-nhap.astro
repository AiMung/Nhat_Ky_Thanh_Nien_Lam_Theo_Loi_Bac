---
import RootLayout from '@/layouts/RootLayout.astro';
import { withBase } from '@/lib/utils';
---

<RootLayout title="Đăng nhập tài khoản - Nhật Ký Thanh Niên Làm Theo Lời Bác">
  <div class="max-w-md mx-auto px-4 py-16">
    <div class="bg-white p-8 sm:p-10 rounded-3xl border border-slate-200 shadow-xl text-center">
      
      <!-- Huy hiệu Đoàn -->
      <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-redflag-700 to-doan-800 flex items-center justify-center text-gold-300 font-serif font-black text-2xl mx-auto mb-4 shadow-lg">
        ★
      </div>

      <span class="text-[11px] font-bold text-doan-800 bg-doan-50 px-3 py-1 rounded-full border border-doan-200 uppercase tracking-wider">
        Thành Đoàn TP. Hồ Chí Minh
      </span>

      <h1 class="font-serif font-black text-2xl text-slate-900 mt-2.5 mb-2">
        Đăng Nhập Hệ Thống
      </h1>
      <p class="text-xs text-slate-500 mb-8 leading-relaxed">
        Chọn quyền truy cập để trải nghiệm đầy đủ chức năng gửi bài, quản lý nhật ký và duyệt bài viết.
      </p>

      <div class="space-y-3">
        <!-- Đăng nhập 1 chạm với tư cách Quản trị Ban Biên tập -->
        <button
          id="btnAdminLogin"
          class="w-full flex items-center justify-center gap-2.5 py-3.5 px-4 rounded-xl bg-redflag-800 hover:bg-redflag-900 text-white text-xs sm:text-sm font-bold shadow-md transition-all hover:scale-[1.01]"
        >
          <span>🛡️</span>
          <span>Đăng nhập quyền Ban Biên tập (Admin)</span>
        </button>

        <!-- Đăng nhập 1 chạm với tư cách Đoàn viên -->
        <button
          id="btnMemberLogin"
          class="w-full flex items-center justify-center gap-2.5 py-3.5 px-4 rounded-xl bg-doan-800 hover:bg-doan-900 text-white text-xs sm:text-sm font-bold shadow-md transition-all hover:scale-[1.01]"
        >
          <span>👤</span>
          <span>Đăng nhập quyền Đoàn viên TP.HCM</span>
        </button>

        <div class="flex items-center gap-3 my-4">
          <div class="h-px flex-1 bg-slate-200"></div>
          <span class="text-xs text-slate-400">hoặc qua Email</span>
          <div class="h-px flex-1 bg-slate-200"></div>
        </div>

        <input
          type="email"
          id="emailBox"
          placeholder="Nhập email của bạn (vd: doanvien@tphcm.gov.vn)..."
          class="w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-900 text-xs sm:text-sm focus:ring-2 focus:ring-doan-700 focus:outline-none"
        />

        <button
          id="btnMagicLogin"
          class="w-full py-3 px-4 rounded-xl border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs font-semibold transition-colors"
        >
          Gửi mã đăng nhập nhanh qua Email
        </button>
      </div>

    </div>
  </div>

  <script is:inline define:vars={{ homeUrl: withBase('/'), adminUrl: withBase('/quan-tri/duyet-bai') }}>
    document.getElementById('btnAdminLogin')?.addEventListener('click', () => {
      localStorage.setItem('dtn_hcm_current_user_v2', JSON.stringify({
        id: 'admin-1',
        name: 'Đ/c Trần Quốc Tuấn',
        email: 'bientap@thanhdoan.tphcm.gov.vn',
        unit: 'Ban Tuyên giáo Thành Đoàn TP.HCM',
        role: 'admin',
        avatar: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=200&q=80'
      }));
      window.dispatchEvent(new Event('auth-changed'));
      alert('Đăng nhập thành công với quyền: Quản trị viên Ban Biên tập!');
      window.location.href = adminUrl;
    });

    document.getElementById('btnMemberLogin')?.addEventListener('click', () => {
      localStorage.setItem('dtn_hcm_current_user_v2', JSON.stringify({
        id: 'user-1',
        name: 'Nguyễn Văn An',
        email: 'vanan.doan@tphcm.gov.vn',
        unit: 'Chi đoàn Ban Phong trào Thành Đoàn',
        role: 'member',
        avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=200&q=80'
      }));
      window.dispatchEvent(new Event('auth-changed'));
      alert('Đăng nhập thành công với tư cách Đoàn viên TP.HCM!');
      window.location.href = homeUrl;
    });

    document.getElementById('btnMagicLogin')?.addEventListener('click', () => {
      const email = document.getElementById('emailBox').value;
      if (!email) {
        alert('Vui lòng nhập email của bạn.');
        return;
      }
      localStorage.setItem('dtn_hcm_current_user_v2', JSON.stringify({
        id: 'user-' + Date.now(),
        name: email.split('@')[0],
        email: email,
        unit: 'Đoàn Thanh niên TP.HCM',
        role: 'member',
        avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=200&q=80'
      }));
      window.dispatchEvent(new Event('auth-changed'));
      alert('Đã gửi xác thực và đăng nhập thành công!');
      window.location.href = homeUrl;
    });
  </script>
</RootLayout>
