# Supabase Credentials (Anon Key công khai dùng ở Client)
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudinary Unsigned Upload Preset (Cho upload ảnh client-side)
PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
PUBLIC_CLOUDINARY_UPLOAD_PRESET=kyuc_unsigned

# Cloudflare Turnstile (Site Key công khai chống spam form)
PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Cấu hình GitHub Pages (nếu deploy vào sub-folder)
BASE_PATH=/
SITE_URL=https://dtn-hcm.github.io

