# ==========================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN NHẬT KÝ THANH NIÊN LÀM THEO LỜI BÁC
# ĐOÀN TNCS HỒ CHÍ MINH PHƯỜNG XUÂN HƯƠNG — ĐÀ LẠT
# ==========================================================

# 1. CẤU HÌNH SUPABASE (Cơ sở dữ liệu đám mây PostgreSQL miễn phí)
# Lấy tại: https://app.supabase.com -> Project Settings -> API
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# 2. CẤU HÌNH CLOUDINARY (Lưu trữ hình ảnh, video, âm thanh tốc độ cao)
# Lấy tại: https://cloudinary.com/console -> Dashboard & Settings -> Upload -> Upload presets
PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# LƯU Ý: Nếu chưa điền các biến trên, hệ thống vẫn hoạt động 100%
# nhờ cơ chế lưu trữ cục bộ LocalStorage & In-memory Fallback thông minh!
